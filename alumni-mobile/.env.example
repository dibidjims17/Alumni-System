# Expo CLI requires the EXPO_PUBLIC_ prefix and static dot notation.
# This value is public and will be embedded in the application bundle.
EXPO_PUBLIC_API_URL=https://reunio-api-production-35f0d0ba.up.railway.app/api

# Pilot tour is disabled in release builds unless explicitly enabled.
EXPO_PUBLIC_PILOT_TOUR_ENABLED=false

# Published Google Form responder URL. Never use the owner/edit URL.
EXPO_PUBLIC_PILOT_FEEDBACK_FORM_URL=

# Railway/API remains the remote kill switch:
# PilotTour__Enabled=true
# PilotTour__Version=pilot-tour-v1
# PilotTour__FeedbackFormUrl=https://docs.google.com/forms/...
