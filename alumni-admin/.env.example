# Copy to .env and fill in your real values (never commit .env).
# Local default: http://YOUR_LAN_IP:5207/api
# Cloudflare Pages: https://api.YOUR_DOMAIN/api
VITE_API_BASE_URL=http://localhost:5207/api

# Get the ID from Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
VITE_GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_WEB_CLIENT_ID_HERE.apps.googleusercontent.com
